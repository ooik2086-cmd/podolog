---
// Табанның қысым картасы: подометрия нәтижесіне ұқсас көрнекі иллюстрация.
// Нақты пациенттің деректері емес.
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';
const t = ui[getLang(Astro)];
const [toe, fore, arch, heel] = t.scanTags;
---
<figure class="scan" aria-label={t.scanAria}>
  <div class="scan3d" aria-hidden="true">
    <canvas></canvas>
    <span class="tag" data-tag="0">{toe}</span>
    <span class="tag" data-tag="1">{fore}</span>
    <span class="tag" data-tag="2">{arch}</span>
    <span class="tag" data-tag="3">{heel}</span>
  </div>
  <svg class="scan2d" viewBox="0 0 320 560" role="img" aria-hidden="true">
    <defs>
      <pattern id="dots" width="12" height="12" patternUnits="userSpaceOnUse">
        <circle cx="6" cy="6" r="1.1" fill="var(--green)" opacity=".18" />
      </pattern>
      <radialGradient id="hot">
        <stop offset="0" stop-color="var(--navy)" stop-opacity=".95" />
        <stop offset=".35" stop-color="var(--green)" stop-opacity=".85" />
        <stop offset=".75" stop-color="var(--green)" stop-opacity=".25" />
        <stop offset="1" stop-color="var(--green)" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="warm">
        <stop offset="0" stop-color="var(--green)" stop-opacity=".7" />
        <stop offset="1" stop-color="var(--green)" stop-opacity="0" />
      </radialGradient>
      <clipPath id="sole">
        <path id="solePath" d="M150 28c46 0 76 34 80 92 3 44-6 82-10 122-4 44 6 86 8 130 4 82-28 158-88 158-52 0-80-44-80-104 0-50 18-82 18-128 0-40-20-74-24-124-6-80 34-146 96-146Z" />
      </clipPath>
    </defs>
    <rect width="320" height="560" fill="url(#dots)" />
    <g clip-path="url(#sole)">
      <rect width="320" height="560" fill="var(--mint)" />
      <ellipse class="blob b1" cx="140" cy="168" rx="84" ry="52" fill="url(#hot)" />
      <ellipse class="blob b2" cx="112" cy="70" rx="32" ry="36" fill="url(#hot)" />
      <ellipse class="blob b3" cx="196" cy="98" rx="30" ry="26" fill="url(#warm)" />
      <ellipse class="blob b4" cx="198" cy="330" rx="26" ry="80" fill="url(#warm)" />
      <ellipse class="blob b5" cx="146" cy="460" rx="62" ry="58" fill="url(#hot)" />
    </g>
    <use href="#solePath" fill="none" stroke="var(--navy)" stroke-width="2" opacity=".5" />
    <g class="labels" font-size="12" font-weight="600" fill="var(--navy)">
      <line x1="112" y1="70" x2="22" y2="44" stroke="var(--navy)" stroke-width="1" opacity=".5" /><circle cx="112" cy="70" r="3" fill="var(--navy)" />
      <text x="16" y="36">{toe}</text>
      <line x1="196" y1="168" x2="300" y2="200" stroke="var(--navy)" stroke-width="1" opacity=".5" /><circle cx="196" cy="168" r="3" fill="var(--navy)" />
      <text x="304" y="196" text-anchor="end">{fore}</text>
      <line x1="100" y1="300" x2="16" y2="300" stroke="var(--navy)" stroke-width="1" opacity=".5" /><circle cx="100" cy="300" r="3" fill="var(--navy)" />
      <text x="16" y="290">{t.scanArch[0]}</text><text x="16" y="322">{t.scanArch[1]}</text>
      <line x1="146" y1="460" x2="300" y2="500" stroke="var(--navy)" stroke-width="1" opacity=".5" /><circle cx="146" cy="460" r="3" fill="var(--navy)" />
      <text x="304" y="496" text-anchor="end">{heel}</text>
    </g>
  </svg>
  <figcaption>
    <span class="legend"><i></i>{t.pressureLow}</span>
    <span class="legend"><i class="hi"></i>{t.pressureHigh}</span>
  </figcaption>
</figure>

<script>
  // Three.js бет көрінгенде ғана жүктеледі
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      import('../scripts/insole3d').then((m) => m.initInsole3D(e.target as HTMLElement)).catch(() => {});
    });
  }, { rootMargin: '300px' });
  document.querySelectorAll('.scan').forEach((el) => io.observe(el));
</script>

<style>
  .scan { margin: 0; display: grid; gap: 12px; justify-items: center; }
  .scan svg { width: 100%; max-width: min(340px, 100%); height: auto; overflow: visible; }
  @media (max-width: 559px) { .scan svg { max-width: 280px; } }
  .blob { transform-box: fill-box; transform-origin: center; animation: breathe 6s ease-in-out infinite; }
  .b2 { animation-delay: -1.5s; } .b3 { animation-delay: -3s; } .b4 { animation-delay: -2s; } .b5 { animation-delay: -4s; }
  @keyframes breathe { 50% { transform: scale(1.06); } }
  figcaption { display: flex; gap: 18px; font-size: var(--fs-xs); color: var(--muted); font-weight: 600; }
  .legend { display: inline-flex; gap: 8px; align-items: center; }
  .legend i { width: 28px; height: 8px; border-radius: 4px; background: linear-gradient(90deg, var(--mint), color-mix(in srgb, var(--green) 50%, var(--mint))); border: 1px solid var(--line); }
  .legend i.hi { background: linear-gradient(90deg, var(--green), var(--navy)); border: 0; }
  .scan3d { display: none; position: relative; width: 100%; max-width: 420px; aspect-ratio: 4 / 5; touch-action: pan-y; cursor: grab; }
  .scan3d:active { cursor: grabbing; }
  .scan3d canvas { width: 100%; height: 100%; display: block; }
  .tag {
    position: absolute; left: 0; top: 0; transform: translate(-50%, -100%); pointer-events: none; white-space: nowrap;
    font-size: 11px; font-weight: 700; color: var(--navy); background: color-mix(in srgb, var(--surface) 88%, transparent);
    border: 1px solid var(--line); border-radius: 999px; padding: 3px 9px; box-shadow: var(--shadow); transition: opacity .2s;
  }
  :global(.scan.is3d) .scan3d { display: block; }
  :global(.scan.is3d) .scan2d { display: none; }
  .labels text { paint-order: stroke; stroke: var(--bg); stroke-width: 4px; }
</style>
