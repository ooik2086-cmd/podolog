---
import Icon from './Icon.astro';
import { getLang } from '../i18n';
import { ui } from '../i18n/ui';
interface Item { image: string; thumb?: string; caption: string; category: string; sub?: string; video?: string }
interface Props { id: string; categories: readonly string[]; items: Item[]; tall?: boolean; emptyTitle: string; emptyText: string }
const { id, categories, items, tall = false, emptyTitle, emptyText } = Astro.props;
const t = ui[getLang(Astro)];
const used = categories.filter((c) => items.some((i) => i.category === c));
---
{items.length ? (
  <>
    <div class="filters" id={id} role="toolbar" aria-label={t.categories}>
      <button type="button" data-filter="all" aria-pressed="true">{t.all}</button>
      {used.map((c) => <button type="button" data-filter={c} aria-pressed="false">{c}</button>)}
    </div>
    <div class="mg">
      {items.map((it) => (
        <figure class="mg__item" data-cat={it.category} data-cat-of={id}>
          {it.video
            ? <div class="mg__v"><video src={it.video} poster={it.image} controls playsinline preload="none" aria-label={it.caption}></video></div>
            : <a href={it.image} data-lb={it.image} data-caption={it.caption} class={tall ? 'tall' : ''}>
                <img src={it.thumb ?? it.image} alt={it.caption} loading="lazy" decoding="async" />
              </a>}
          <figcaption><b>{it.caption}</b>{it.sub && <span class="muted small">{it.sub}</span>}</figcaption>
        </figure>
      ))}
    </div>
  </>
) : (
  <div class="stack-lg">
    <div class="filters" aria-label={t.categories}>
      {categories.map((c) => <button type="button" disabled aria-pressed="false">{c}</button>)}
    </div>
    <div class="empty">
      <Icon name="image" />
      <strong>{emptyTitle}</strong>
      <p>{emptyText}</p>
    </div>
  </div>
)}
<style>
  .mg { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); }
  .mg__item { margin: 0; display: grid; gap: 10px; align-content: start; }
  .mg__item a { display: block; border-radius: var(--r-md); overflow: hidden; aspect-ratio: 4 / 3; background: var(--mint); border: 1px solid var(--line); }
  .mg__item a.tall { aspect-ratio: 1 / 1; background: color-mix(in srgb, var(--mint) 55%, var(--surface)); }
  .mg__item a.tall img { object-fit: contain; padding: 12px; filter: drop-shadow(0 2px 6px rgb(0 0 0 / .12)); }
  .mg__v { border-radius: var(--r-md); overflow: hidden; aspect-ratio: 4 / 3; background: #000; border: 1px solid var(--line); }
  .mg__v video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mg__item img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
  .mg__item a:hover img { transform: scale(1.03); }
  .mg__item figcaption { display: grid; gap: 2px; font-size: var(--fs-sm); }
  .mg__item figcaption b { color: var(--navy); }
  .filters button:disabled { cursor: default; opacity: .7; }
</style>
