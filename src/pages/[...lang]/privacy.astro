---
import { pageText } from '../../data/cms';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { siteFor } from '../../data/site';
import { getLang, langPaths } from '../../i18n';
export function getStaticPaths() {
  return langPaths();
}
const lang = getLang(Astro);
const site = siteFor(lang);
const T = pageText('privacy', {
  kk: {
    title: 'Құпиялылық саясаты', crumb: 'Құпиялылық', desc: 'Подолог орталығы сайтындағы дербес деректерді өңдеу тәртібі.', draft: 'Жоба мәтіні. Заңгермен тексеріп бекіту керек',
    p: [
      `${site.fullName} сайт арқылы қабылдауға жазылу, тапсырыс беру және оқуға тіркелу үшін атыңызды, телефон нөміріңізді және сіз жазған мәліметті алады.`,
      'Бұл деректер тек өтінішіңізді орындау және сізбен байланысу үшін қолданылады, үшінші тұлғаларға сатылмайды. Төлем жасағанда банк картасының деректерін сайт сақтамайды: олар төлем провайдерінің қорғалған бетінде енгізіледі.',
      'Деректеріңізді жоюды немесе өзгертуді сұрау үшін орталыққа хабарласыңыз. Өңдеу Қазақстан Республикасының «Дербес деректер және оларды қорғау туралы» Заңына сай жүргізіледі.',
      'Клиенттердің фотосуреттері мен медициналық мәліметтері олардың келісімінсіз жарияланбайды.',
    ],
  },
  ru: {
    title: 'Политика конфиденциальности', crumb: 'Конфиденциальность', desc: 'Порядок обработки персональных данных на сайте центра «Подолог».', draft: 'Проект текста. Требует проверки и утверждения юристом',
    p: [
      `${site.fullName} получает через сайт ваше имя, номер телефона и указанные вами сведения для записи на приём, оформления заказа и регистрации на обучение.`,
      'Эти данные используются только для выполнения вашего запроса и связи с вами и не продаются третьим лицам. При оплате сайт не хранит данные банковской карты: они вводятся на защищённой странице платёжного провайдера.',
      'Чтобы удалить или изменить свои данные, обратитесь в центр. Обработка ведётся в соответствии с Законом Республики Казахстан «О персональных данных и их защите».',
      'Фотографии и медицинские сведения клиентов не публикуются без их согласия.',
    ],
  },
  en: {
    title: 'Privacy policy', crumb: 'Privacy', desc: 'How the Podolog center website processes personal data.', draft: 'Draft text. Must be reviewed and approved by a lawyer',
    p: [
      `${site.fullName} collects your name, phone number and the details you provide through the website in order to book appointments, process orders and register you for training.`,
      'This data is used only to fulfill your request and contact you, and is never sold to third parties. When you pay, the website does not store your bank card details: they are entered on the payment provider’s secure page.',
      'To request deletion or correction of your data, contact the center. Processing is carried out in accordance with the Law of the Republic of Kazakhstan “On Personal Data and Their Protection”.',
      'Photos and medical information of clients are never published without their consent.',
    ],
  },
})[lang];
---
<Base title={T.title} path="/privacy" description={T.desc}>
  <PageHero title={T.title} crumbs={[{ href: '/privacy', label: T.crumb }]} />
  <section class="section" style="padding-top: 24px;">
    <div class="wrap prose stack">
      <span class="chip chip--warn">{T.draft}</span>
      {T.p.map((x) => <p>{x}</p>)}
    </div>
  </section>
</Base>
<style>.prose { max-width: 70ch; }</style>
